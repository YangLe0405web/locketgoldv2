#!url=https://raw.githubusercontent.com/YangLe0405web/locketgoldv2/main/locketgold.sgmodule
#!name=Locket Gold VIP - Lê Hoàng Giang
#!desc=Mở khóa Locket Gold VIP vĩnh viễn (RevenueCat + Firebase Remote Config). Phát hành bởi Lê Hoàng Giang (LocketGoldGiangLe).
#!author=Lê Hoàng Giang
#!homepage=https://github.com/YangLe0405web/locketgoldv2
#!icon=https://raw.githubusercontent.com/YangLe0405web/locketgoldv2/main/assets/banner.png

[Script]
# Mở khóa gói Locket Gold qua RevenueCat
revenuecat = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://cdn.jsdelivr.net/gh/YangLe0405web/locketgoldv2@main/locketgold/locketlam.js, requires-body=true, max-size=-1, timeout=60

# Xóa ETag header để luôn nhận phản hồi mới từ RevenueCat
deleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://cdn.jsdelivr.net/gh/YangLe0405web/locketgoldv2@main/locketgold/deleteHeader.js, timeout=60

# Mở khóa toàn bộ Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://cdn.jsdelivr.net/gh/YangLe0405web/locketgoldv2@main/locketgold/locket_remote.js, requires-body=true, max-size=-1, timeout=60

# Giữ Huy hiệu Locket Gold luôn BẬT và đồng bộ thông tin tài khoản
locket_badge = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo, script-path=https://cdn.jsdelivr.net/gh/YangLe0405web/locketgoldv2@main/locketgold/locket_profile.js, timeout=60
locket_user = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, script-path=https://cdn.jsdelivr.net/gh/YangLe0405web/locketgoldv2@main/locketgold/locket_profile.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
